# Octofit Tracker frontend environment variables
#
# VITE_CODESPACE_NAME must be defined when running in GitHub Codespaces so the
# presentation tier can reach the forwarded API port at:
#   https://$VITE_CODESPACE_NAME-8000.app.github.dev
#
# GitHub Codespaces does not automatically expose CODESPACE_NAME to Vite
# (only VITE_-prefixed variables are injected into import.meta.env), so copy
# this file to .env.local and set it manually, e.g.:
#   VITE_CODESPACE_NAME=$CODESPACE_NAME
#
# When unset, the app safely falls back to http://localhost:8000.
VITE_CODESPACE_NAME=
